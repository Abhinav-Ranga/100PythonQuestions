   "source": [
    "n = int(input('Enter the number: '))\n",
    "b = n \n",
    "sum = 0\n",
    "numberlength = len(str(n))\n",
    "\n",
    "\n",
    "while b != 0:\n",
    "    a = b % 10\n",
    "    sum += a ** numberlength\n",
    "    b = b//10\n",
    "\n",
    "if n == sum:\n",
    "    print('yes this number is a armstrong')\n",
    "else : \n",
    "    print('this is not a armstrong')\n",
    "    \n",
    "\n"
   ]
